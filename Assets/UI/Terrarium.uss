.root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(250, 243, 230);
}

.top-bar {
    position: relative;
    padding: 12px 64px 12px 64px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.growth-stage-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(90, 62, 40);
}

.profile-chips {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.profile-chip {
    font-size: 18px;
    color: rgb(110, 84, 60);
    white-space: nowrap;
    margin-right: 6px;
}

.gauge-track {
    width: 100%;
    height: 14px;
    margin-top: 6px;
    background-color: rgba(90, 62, 40, 0.15);
    border-radius: 7px;
    overflow: hidden;
}

.gauge-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(255, 167, 38);
}

.breeding-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
}

.breeding-status-label {
    font-size: 12px;
    color: rgb(110, 84, 60);
    white-space: normal;
    height: 42px;
    -unity-text-align: upper-center;
    flex-grow: 1;
}

.breeding-status-weak {
    color: rgb(198, 40, 40);
}

.nest-box-button {
    font-size: 11px;
    padding: 2px 6px;
    height: 24px;
    margin-left: 6px;
}

.terrarium-view {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(120, 78, 52);
}

/* The art is sized and positioned from code by TerrariumProjection (cover, anchored to
   the floor), the same mapping that stands the pet and decor on the floor, so the three
   can never disagree. Its element always has the art's own aspect ratio. */
.terrarium-background {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-image: url("/Assets/Art/terrarium_background.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Local time of day and the weather at the player's location. Fixed height so updates
   never shift the layout. */
.environment-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 24px;
    flex-shrink: 0;
    padding: 0 16px;
}

.environment-label {
    font-size: 13px;
    color: rgb(90, 62, 40);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.day-phase-label {
    -unity-font-style: bold;
    flex-shrink: 0;
    margin-right: 12px;
}

.weather-label {
    flex-shrink: 1;
    -unity-text-align: middle-right;
}

/* Time-of-day light (night darkness, dusk glow) over the pet and decor. */
.terrarium-lighting {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Hearts and Zzz float in this layer, always drawn above the pet and decor. */
.terrarium-effects {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Placed on the background's floor (or glass top) by TerrariumView.PlaceDecor. */
.decor-image {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* Position, size, facing and bobbing are driven by PetActor. */
.pet-image {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    background-image: url("/Assets/Resources/Gecko/idle_00.png");
    -unity-background-scale-mode: scale-to-fit;
}

.status-section {
    padding: 12px 20px 4px;
    flex-direction: column;
    background-color: rgb(250, 243, 230);
}

.status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.status-label {
    width: 64px;
    font-size: 16px;
    color: rgb(90, 62, 40);
}

.status-bar-track {
    flex-grow: 1;
    height: 14px;
    margin: 0 10px;
    background-color: rgba(90, 62, 40, 0.15);
    border-radius: 7px;
    overflow: hidden;
}

.status-bar-fill {
    height: 100%;
    width: 0%;
}

.status-value {
    width: 40px;
    font-size: 16px;
    -unity-text-align: middle-right;
    color: rgb(90, 62, 40);
}

/* Fixed-height slot reserved for messages: text appears/disappears via visibility only,
   so showing a message never moves the terrarium or the buttons. */
.feedback-label {
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    margin: 2px 16px 2px;
    padding: 0;
    font-size: 15px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bottom-bar {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 4px 16px 12px;
}

.care-button {
    width: 48.5%;
    margin: 0 0 8px 0;
    height: 56px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.milestone-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.milestone-modal-card {
    width: 88%;
    max-height: 90%;
    padding: 20px;
    background-color: rgb(250, 243, 230);
    border-radius: 16px;
    align-items: center;
}

.milestone-stage-label {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(90, 62, 40);
    margin-bottom: 10px;
}

.milestone-message-label {
    font-size: 18px;
    color: rgb(90, 62, 40);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.milestone-continue-button {
    width: 70%;
    height: 48px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.decor-icon-rock_01 {
    background-image: url("/Assets/Art/decor_rock_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-icon-plant_01 {
    background-image: url("/Assets/Art/decor_plant_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-icon-water_dish_01 {
    background-image: url("/Assets/Art/decor_water_dish_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-icon-heat_lamp_01 {
    background-image: url("/Assets/Art/decor_heat_lamp_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-icon-driftwood_01 {
    background-image: url("/Assets/Art/decor_driftwood_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-drawer-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(90, 62, 40);
    margin-bottom: 12px;
}

.decor-list {
    width: 100%;
}

.decor-row {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-bottom: 8px;
    padding: 0 10px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.08);
}

.decor-row:disabled {
    opacity: 0.45;
}

.decor-icon {
    width: 40px;
    height: 40px;
    margin-right: 12px;
}

.decor-name-label {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-left;
}

.decor-status-label {
    font-size: 13px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-right;
}

.debug-button {
    position: absolute;
    top: 12px;
    right: 8px;
    width: 64px;
    height: 44px;
    font-size: 13px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.6);
    color: rgb(255, 255, 255);
}

.debug-multiplier-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
}

.debug-small-button {
    width: 72px;
    height: 44px;
    margin: 0 6px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
}

.debug-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.debug-slider-label {
    width: 64px;
    font-size: 14px;
    color: rgb(90, 62, 40);
}

.debug-slider {
    flex-grow: 1;
}

.debug-applied-elapsed-label {
    font-size: 13px;
    color: rgb(90, 62, 40);
    margin: 8px 0;
    -unity-text-align: middle-center;
}

.debug-clear-save-button {
    height: 44px;
    margin-bottom: 10px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(229, 57, 53);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
}

.status-good {
    background-color: rgb(67, 160, 71);
}

.status-warning {
    background-color: rgb(253, 216, 53);
}

.status-critical {
    background-color: rgb(229, 57, 53);
}

/* App shell: header, screens and the tab bar. Screens fill the space between header and
   the bottom; heights are fixed so nothing shifts as text changes. */
.app-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    flex-shrink: 0;
    padding: 0 12px;
}

.header-button {
    height: 32px;
    min-width: 64px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.15);
    color: rgb(90, 62, 40);
    font-size: 14px;
}

.header-date,
.header-money {
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-font-style: bold;
}

.screen {
    flex-grow: 1;
    flex-direction: column;
}

.screen-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(90, 62, 40);
    margin: 8px 16px;
}

.rack-list {
    flex-grow: 1;
    padding: 0 12px;
}

.rack-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
    padding: 8px 4px;
    border-bottom-width: 6px;
    border-bottom-color: rgb(140, 100, 70);
}

.rack-slot {
    width: 23%;
    height: 120px;
    margin: 0;
    padding: 4px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(140, 100, 70);
    background-color: rgb(245, 225, 190);
    flex-direction: column;
    align-items: center;
}

.rack-slot-empty {
    background-color: rgba(90, 62, 40, 0.06);
    border-color: rgba(90, 62, 40, 0.2);
}

/* A male's cage while a female is visiting it for pairing (§7.2). */
.rack-slot-visiting {
    border-width: 3px;
    border-color: rgb(233, 30, 99);
}

/* Aspect close to the cropped thumbnail's ~194:82 ratio so the body fills the frame
   instead of being letterboxed by scale-to-fit. */
.rack-thumb {
    width: 100%;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

/* The small overlay in the corner of a visiting slot: the visiting female's own
   thumbnail plus "訪問中", kept inside the rack-slot's own bounds. */
.rack-visitor {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 34%;
    height: 30px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(233, 30, 99);
    padding: 1px;
}

.rack-visitor-thumb {
    width: 100%;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
}

.rack-visitor-label {
    font-size: 7px;
    color: rgb(194, 24, 91);
    white-space: nowrap;
}

/* The weakness mark (§5.5): a small red "！" over the top-right corner of a thumbnail. */
.rack-badge-weak {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(229, 57, 53);
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.rack-name {
    font-size: 12px;
    color: rgb(90, 62, 40);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rack-alert {
    height: 26px;
    font-size: 9px;
    color: rgb(229, 57, 53);
    white-space: normal;
    overflow: hidden;
}

.home-incubator {
    height: 48px;
    margin: 8px 16px 12px;
    border-radius: 12px;
}

.tab-content {
    flex-grow: 1;
}

.panel {
    flex-grow: 1;
    flex-direction: column;
}

.bulk-bar {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 12px;
}

.bulk-button {
    width: 32%;
    height: 44px;
    margin: 0;
    border-radius: 10px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
}

.cage-list {
    flex-grow: 1;
    padding: 0 12px;
}

.cage-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin: 0 0 8px 0;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.08);
}

/* A male's cage while a female is visiting it for pairing (§7.2). */
.cage-row-visiting {
    border-width: 2px;
    border-color: rgb(233, 30, 99);
}

/* Aspect close to the cropped thumbnail's ~194:82 ratio so the body fills the frame
   instead of being letterboxed by scale-to-fit. */
.cage-row-thumb {
    width: 132px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

/* The weakness mark (§5.5) on the cage-list row's thumbnail. */
.cage-row-badge-weak {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(229, 57, 53);
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cage-row-texts {
    flex-grow: 1;
    -unity-text-align: middle-left;
    color: rgb(90, 62, 40);
}

.cage-row-detail {
    font-size: 12px;
    color: rgb(120, 90, 60);
}

/* Fixed-height slot above the cage list, reserved for CageStatusText.NoAnimalsMessage
   (visibility only, like .feedback-label) so it never shifts the bulk-care bar. */
.cage-list-empty-label {
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    margin: 6px 16px 0;
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
}

.shop-section-bar {
    flex-direction: row;
    height: 44px;
    flex-shrink: 0;
}

.shop-section-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(90, 62, 40, 0.08);
    color: rgb(140, 110, 80);
    font-size: 14px;
}

.shop-restock-label {
    height: 20px;
    min-height: 20px;
    flex-shrink: 0;
    margin: 6px 16px 0;
    font-size: 13px;
    color: rgb(90, 62, 40);
}

/* Fixed-height slot for shop feedback (buy/wholesale result), visibility only like
   .feedback-label so a message never shifts the list. */
.shop-message-label {
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    margin: 4px 16px;
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.shop-list {
    flex-grow: 1;
    padding: 0 12px;
}

/* A row is a small vertical card, not one cramped horizontal line: on a phone-width screen
   there is not enough room for thumbnail + wrapping name/detail + price + button side by
   side, so the thumbnail sits with the name on its own header line, the detail text gets
   the row's full width to wrap in, and price/button share a footer line. This is what lets
   a long, multi-word morph name actually wrap at word boundaries instead of being squeezed
   into a sliver of a column and breaking mid-word. */
.shop-row {
    flex-direction: column;
    min-height: 72px;
    margin: 0 0 8px 0;
    padding: 8px 10px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.08);
}

.shop-row-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.shop-row-thumb {
    width: 64px;
    height: 36px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* white-space: normal wraps at word boundaries, so a long morph name (space-separated
   words) breaks between words instead of overflowing the row. flex-basis: 0 makes this
   label take exactly its flex-grow share of the header row (the default "auto" basis sizes
   off the unwrapped text's full width first, which can squeeze it far narrower than the
   space actually available next to the thumbnail). */
.shop-row-name-label {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    font-size: 14px;
    color: rgb(90, 62, 40);
    white-space: normal;
}

.shop-row-detail-label {
    font-size: 12px;
    color: rgb(120, 90, 60);
    white-space: normal;
    margin-bottom: 2px;
}

.shop-row-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
}

.shop-row-price-label {
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-font-style: bold;
}

.shop-buy-button {
    width: 96px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 10px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
}

.shop-empty-label {
    margin: 24px 8px;
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: normal;
}

.confirm-button-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.confirm-yes-button,
.confirm-no-button {
    width: 47%;
    height: 48px;
    border-radius: 12px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.confirm-yes-button {
    background-color: rgb(255, 167, 38);
}

.confirm-no-button {
    background-color: rgba(90, 62, 40, 0.4);
}

.placeholder-label {
    margin: 40px 16px;
    font-size: 16px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: normal;
}

.tab-bar {
    flex-direction: row;
    height: 56px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgba(90, 62, 40, 0.2);
}

.tab-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(140, 110, 80);
    font-size: 12px;
}

.tab-selected {
    color: rgb(255, 140, 0);
    -unity-font-style: bold;
}

.cage-nav {
    flex-direction: row;
    align-items: center;
    height: 36px;
}

/* Reserves room for the absolutely-positioned .debug-button (top-right of .top-bar) so it
   never covers the next-cage button; toggled on .top-bar in TerrariumView.ApplyDebugVisibility
   only for debug builds, where the debug button is actually visible. */
.top-bar-with-debug .cage-nav {
    margin-right: 72px;
}

.cage-nav-button {
    width: 44px;
    height: 36px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.12);
    color: rgb(90, 62, 40);
}

.cage-title-label {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Ledger tab (§6.2): the animal list and money in/out. Reuses .shop-section-bar/-button for
   its own section buttons (see Terrarium.uxml). */
.ledger-summary-label {
    height: 20px;
    min-height: 20px;
    flex-shrink: 0;
    margin: 6px 16px 0;
    font-size: 13px;
    color: rgb(90, 62, 40);
}

.ledger-list {
    flex-grow: 1;
    padding: 0 12px;
}

/* Same column-card shape as .shop-row: thumbnail+name on a header line, then the
   non-wrapping profile words, then the age/weight detail line. */
.ledger-row {
    flex-direction: column;
    min-height: 72px;
    margin: 0 0 8px 0;
    padding: 8px 10px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.08);
}

.ledger-row-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.ledger-row-thumb {
    width: 64px;
    height: 36px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.ledger-row-name-label {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    font-size: 14px;
    color: rgb(90, 62, 40);
    white-space: normal;
}

/* The morph/personality words must stay on one line each (no mid-word breaks), so unlike
   the detail label below this one does not wrap. */
.ledger-row-profile-label {
    font-size: 12px;
    color: rgb(120, 90, 60);
    white-space: nowrap;
    margin-bottom: 2px;
}

.ledger-row-detail-label {
    font-size: 12px;
    color: rgb(120, 90, 60);
    white-space: normal;
}

/* One money-in/out line: the note wraps and gets the row's space, the amount stays put on
   the right so every row's yen figures line up. */
.ledger-money-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    margin: 0 0 6px 0;
    padding: 8px 10px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.08);
}

.ledger-money-row .ledger-row-detail-label {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 10px;
}

.ledger-money-amount-label {
    flex-shrink: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.ledger-money-income {
    color: rgb(76, 140, 74);
}

.ledger-money-expense {
    color: rgb(140, 90, 60);
}

.ledger-empty-label {
    margin: 24px 8px;
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: normal;
}
