.root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(250, 243, 230);
}

.top-bar {
    position: relative;
    padding: 12px 64px 12px 64px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.growth-stage-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(90, 62, 40);
}

.gauge-track {
    width: 100%;
    height: 14px;
    margin-top: 6px;
    background-color: rgba(90, 62, 40, 0.15);
    border-radius: 7px;
    overflow: hidden;
}

.gauge-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(255, 167, 38);
}

.terrarium-view {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(120, 78, 52);
}

/* The art is sized and positioned from code by TerrariumProjection (cover, anchored to
   the floor), the same mapping that stands the pet and decor on the floor, so the three
   can never disagree. Its element always has the art's own aspect ratio. */
.terrarium-background {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-image: url("/Assets/Art/terrarium_background.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Local time of day and the weather at the player's location. Fixed height so updates
   never shift the layout. */
.environment-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 24px;
    flex-shrink: 0;
    padding: 0 16px;
}

.environment-label {
    font-size: 13px;
    color: rgb(90, 62, 40);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.day-phase-label {
    -unity-font-style: bold;
    flex-shrink: 0;
    margin-right: 12px;
}

.weather-label {
    flex-shrink: 1;
    -unity-text-align: middle-right;
}

/* Time-of-day light (night darkness, dusk glow) over the pet and decor. */
.terrarium-lighting {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Hearts and Zzz float in this layer, always drawn above the pet and decor. */
.terrarium-effects {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Placed on the background's floor (or glass top) by TerrariumView.PlaceDecor. */
.decor-image {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* Position, size, facing and bobbing are driven by PetActor. */
.pet-image {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    background-image: url("/Assets/Resources/Gecko/idle_00.png");
    -unity-background-scale-mode: scale-to-fit;
}

.status-section {
    padding: 12px 20px 4px;
    flex-direction: column;
    background-color: rgb(250, 243, 230);
}

.status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.status-label {
    width: 64px;
    font-size: 16px;
    color: rgb(90, 62, 40);
}

.status-bar-track {
    flex-grow: 1;
    height: 14px;
    margin: 0 10px;
    background-color: rgba(90, 62, 40, 0.15);
    border-radius: 7px;
    overflow: hidden;
}

.status-bar-fill {
    height: 100%;
    width: 0%;
}

.status-value {
    width: 40px;
    font-size: 16px;
    -unity-text-align: middle-right;
    color: rgb(90, 62, 40);
}

/* Fixed-height slot reserved for messages: text appears/disappears via visibility only,
   so showing a message never moves the terrarium or the buttons. */
.feedback-label {
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    margin: 2px 16px 2px;
    padding: 0;
    font-size: 15px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bottom-bar {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 4px 16px 12px;
}

.care-button {
    width: 48.5%;
    margin: 0 0 8px 0;
    height: 56px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.milestone-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.milestone-modal-card {
    width: 88%;
    max-height: 90%;
    padding: 20px;
    background-color: rgb(250, 243, 230);
    border-radius: 16px;
    align-items: center;
}

.milestone-stage-label {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(90, 62, 40);
    margin-bottom: 10px;
}

.milestone-message-label {
    font-size: 18px;
    color: rgb(90, 62, 40);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.milestone-continue-button {
    width: 70%;
    height: 48px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.decor-icon-rock_01 {
    background-image: url("/Assets/Art/decor_rock_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-icon-plant_01 {
    background-image: url("/Assets/Art/decor_plant_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-icon-water_dish_01 {
    background-image: url("/Assets/Art/decor_water_dish_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-icon-heat_lamp_01 {
    background-image: url("/Assets/Art/decor_heat_lamp_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-icon-driftwood_01 {
    background-image: url("/Assets/Art/decor_driftwood_01.png");
    -unity-background-scale-mode: scale-to-fit;
}

.decor-drawer-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(90, 62, 40);
    margin-bottom: 12px;
}

.decor-list {
    width: 100%;
}

.decor-row {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-bottom: 8px;
    padding: 0 10px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.08);
}

.decor-row:disabled {
    opacity: 0.45;
}

.decor-icon {
    width: 40px;
    height: 40px;
    margin-right: 12px;
}

.decor-name-label {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-left;
}

.decor-status-label {
    font-size: 13px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-right;
}

.debug-button {
    position: absolute;
    top: 12px;
    right: 8px;
    width: 64px;
    height: 44px;
    font-size: 13px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.6);
    color: rgb(255, 255, 255);
}

.debug-multiplier-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
}

.debug-small-button {
    width: 72px;
    height: 44px;
    margin: 0 6px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
}

.debug-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.debug-slider-label {
    width: 64px;
    font-size: 14px;
    color: rgb(90, 62, 40);
}

.debug-slider {
    flex-grow: 1;
}

.debug-applied-elapsed-label {
    font-size: 13px;
    color: rgb(90, 62, 40);
    margin: 8px 0;
    -unity-text-align: middle-center;
}

.debug-clear-save-button {
    height: 44px;
    margin-bottom: 10px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(229, 57, 53);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
}

.status-good {
    background-color: rgb(67, 160, 71);
}

.status-warning {
    background-color: rgb(253, 216, 53);
}

.status-critical {
    background-color: rgb(229, 57, 53);
}

/* App shell: header, screens and the tab bar. Screens fill the space between header and
   the bottom; heights are fixed so nothing shifts as text changes. */
.app-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    flex-shrink: 0;
    padding: 0 12px;
}

.header-button {
    height: 32px;
    min-width: 64px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.15);
    color: rgb(90, 62, 40);
    font-size: 14px;
}

.header-date,
.header-money {
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-font-style: bold;
}

.screen {
    flex-grow: 1;
    flex-direction: column;
}

.screen-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(90, 62, 40);
    margin: 8px 16px;
}

.rack-list {
    flex-grow: 1;
    padding: 0 12px;
}

.rack-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
    padding: 8px 4px;
    border-bottom-width: 6px;
    border-bottom-color: rgb(140, 100, 70);
}

.rack-slot {
    width: 23%;
    height: 110px;
    margin: 0;
    padding: 4px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(140, 100, 70);
    background-color: rgb(245, 225, 190);
    flex-direction: column;
    align-items: center;
}

.rack-slot-empty {
    background-color: rgba(90, 62, 40, 0.06);
    border-color: rgba(90, 62, 40, 0.2);
}

.rack-thumb {
    width: 100%;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.rack-name {
    font-size: 12px;
    color: rgb(90, 62, 40);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rack-alert {
    height: 16px;
    font-size: 10px;
    color: rgb(229, 57, 53);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.home-incubator {
    height: 48px;
    margin: 8px 16px 12px;
    border-radius: 12px;
}

.tab-content {
    flex-grow: 1;
}

.panel {
    flex-grow: 1;
    flex-direction: column;
}

.bulk-bar {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 12px;
}

.bulk-button {
    width: 32%;
    height: 44px;
    margin: 0;
    border-radius: 10px;
    border-width: 0;
    background-color: rgb(255, 167, 38);
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
}

.cage-list {
    flex-grow: 1;
    padding: 0 12px;
}

.cage-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin: 0 0 8px 0;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.08);
}

.cage-row-thumb {
    width: 72px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.cage-row-texts {
    flex-grow: 1;
    -unity-text-align: middle-left;
    color: rgb(90, 62, 40);
}

.cage-row-detail {
    font-size: 12px;
    color: rgb(120, 90, 60);
}

.placeholder-label {
    margin: 40px 16px;
    font-size: 16px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: normal;
}

.tab-bar {
    flex-direction: row;
    height: 56px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgba(90, 62, 40, 0.2);
}

.tab-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(140, 110, 80);
    font-size: 12px;
}

.tab-selected {
    color: rgb(255, 140, 0);
    -unity-font-style: bold;
}

.cage-nav {
    flex-direction: row;
    align-items: center;
    height: 36px;
}

/* Reserves room for the absolutely-positioned .debug-button (top-right of .top-bar) so it
   never covers the next-cage button; toggled on .top-bar in TerrariumView.ApplyDebugVisibility
   only for debug builds, where the debug button is actually visible. */
.top-bar-with-debug .cage-nav {
    margin-right: 72px;
}

.cage-nav-button {
    width: 44px;
    height: 36px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(90, 62, 40, 0.12);
    color: rgb(90, 62, 40);
}

.cage-title-label {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(90, 62, 40);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
